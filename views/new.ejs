<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New message</title>
</head>
<body>
<form action="/chats" method="POST"> 
    <label>From:</label> 
    <input type="text" name="from" required> <br><br> 
    <label>To:</label> <input type="text" name="to" required> <br><br> 
    <label>Message:</label> <textarea name="msg" required></textarea>
     <br><br>
     <button type="submit">Send</button> 
</form>
</body>
</html>